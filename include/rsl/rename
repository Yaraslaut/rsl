#pragma once
#include <rsl/string_view>
#include <rsl/meta_traits>

#include <string_view>

namespace rsl {

/// @brief simple type to represent renaming of a symbol
/// with the main purpose of being used in consteval context
///
struct rename {
  rsl::string_view name{};
  consteval explicit rename(std::string_view name) : name(define_static_string(name)) {}
  consteval auto operator<=>(const rename&) const = default;
};

/// @brief helper function to check if reflecteditem has a rename annotation
consteval bool has_rename_annotation(std::meta::info item) {
  return meta::has_annotation<rename>(item);
}

}  // namespace rsl
